# Sloth Music Platform — Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or production secrets to version control.

# Application Environment
NODE_ENV=development
APP_PORT=3000

# Backend Engine & WebSocket Server
FASTAPI_ENGINE_HOST=127.0.0.1
FASTAPI_ENGINE_PORT=8000
LISTEN_TOGETHER_PORT=8001

# Database (Local SQLite via Drizzle ORM)
DATABASE_URL=file:./sloth.db

# Audio & Proxy Configurations
PIPED_INSTANCE_API=https://pipedapi.kavin.rocks
SPONSORBLOCK_API=https://sponsor.ajay.app

# AI Lyrics Translation (Claude API)
ANTHROPIC_API_KEY=

# Qobuz Hi-Res Lossless Audio Provider
# Required for official API authentication; public mirrors used as fallback
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=

# User Personalization Defaults
DEFAULT_ACCENT_COLOR=oklch(0.72 0.19 145)

